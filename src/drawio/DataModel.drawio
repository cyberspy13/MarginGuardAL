t;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad7ac;strokeColor=#b46504;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="1180" width="200" height="100" as="geometry"/></mxCell><mxCell id="build-111" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="build-109" target="build-110"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="build-112" value="&lt;b&gt;9.3 T50113 Profitability Buffer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;TableType = Temporary&lt;br&gt;Item, Customer, Sales, COGS, Variance,&lt;br&gt;Rebate, Net Margin&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad7ac;strokeColor=#b46504;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="1180" width="200" height="100" as="geometry"/></mxCell><mxCell id="build-113" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="build-110" target="build-112"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="build-114" value="&lt;b&gt;9.4 Test codeunits 50200–50209&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;MG Test Library + one per scenario&lt;br&gt;+ 50209 Cross-Module test&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad7ac;strokeColor=#b46504;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="1180" width="200" height="100" as="geometry"/></mxCell><mxCell id="build-115" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="build-112" target="build-114"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="build-116" value="&lt;b&gt;✔ Checkpoint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Post rebate → cockpit changes; Power BI connects&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#b46504;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1640" y="1180" width="220" height="100" as="geometry"/></mxCell><mxCell id="build-117" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;strokeColor=#999999;fontSize=10;" edge="1" parent="1" source="build-114" target="build-116"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="build-118" value="&lt;b&gt;STEP 10&lt;br&gt;Stretch&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#999999;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1300" width="170" height="100" as="geometry"/></mxCell><mxCell id="build-119" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=10;" edge="1" parent="1" source="build-107" target="build-118"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="build-120" value="&lt;b&gt;10.1 Upgrade codeunit 50101&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Split Rebate Agreement into&lt;br&gt;header + lines, upgrade tags&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="1300" width="200" height="100" as="geometry"/></mxCell><mxCell id="build-121" value="&lt;b&gt;10.2 Approval workflow&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Replace direct override with&lt;br&gt;standard Workflow&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;arcSize=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="1300" width="200" height="100" as="geometry"/></mxCell><mxCell id="build-122" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="build-120" target="build-121"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="build-123" value="&lt;b&gt;✔ Checkpoint&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Optional&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1640" y="1300" width="220" height="100" as="geometry"/></mxCell><mxCell id="build-124" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;dashed=1;strokeColor=#999999;fontSize=10;" edge="1" parent="1" source="build-121" target="build-123"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="build-125" value="&lt;b&gt;Rules for every step (from sections 4.3, 7 and 10.1)&lt;/b&gt;&lt;br&gt;• Prefix every object and every field added to a standard table with &lt;b&gt;MG&lt;/b&gt;.&lt;br&gt;• Extend a standard table when the field describes that record (Quality Status on a lot, Margin Policy on a customer). Create a new table when the data has its own lifecycle, its own key or many rows per standard record (inspections, rebate entries, override log).&lt;br&gt;• Ledger tables (Rebate Entry, Assembly Variance Entry) are append-only: corrections are new entries, never edits.&lt;br&gt;• Calculated values you write (margin %, cost basis) are normal stored fields. FlowFields only for read-only sums (Accrued Amount).&lt;br&gt;• Set DataClassification on every new field. Use SetLoadFields before FindSet on Value Entry / Item Ledger Entry / Sales Line.&lt;br&gt;• Never put expected cost into standard Unit Cost (LCY). Never modify posted documents: status lives in MG tables." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1430" width="900" height="230" as="geometry"/></mxCell><mxCell id="build-126" value="&lt;b&gt;Compile-order notes&lt;/b&gt;&lt;br&gt;• The three strategy enums (50101, 50102, 50103) use &lt;i&gt;implements&lt;/i&gt;, so each value needs an Implementation codeunit that already exists. They won&#x27;t compile on their own in Step 1: create each one in its own step together with its codeunits (2.1, 3.1, 7.1). The other seven enums go in Step 1.&lt;br&gt;• Table extensions 50101 (Item) and 50104 (Customer) grow over several steps: add only the fields a step needs, so every TableRelation points to a table that already exists.&lt;br&gt;• Step 4 (S8) comes before Quality (S4) on purpose, per the sprint plan: it turns Step 3&#x27;s stubbed rebate posting into real G/L posting while the rebate model is fresh.&lt;br&gt;• Step 6 needs MG Item Cost Basis (2.6). Step 7 needs Steps 2 + 6 (cost roll-up + variance trend). Step 9 needs Steps 3, 6 and 7." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="1430" width="900" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="erd" name="2 - Data Model (ERD)"><mxGraphModel dx="1906" dy="774" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="erd-1" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Margin Guard App — Table Relationships&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="erd-2" value="Colour = build step (see page 1). Grey dashed = standard Business Central table. Arrow = TableRelation / “points to”. [Sx] = scenario that adds the field." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1800" height="24" as="geometry"/></mxCell><mxCell id="erd-3" value="T50100 MG Setup" style="swimlane;fontStyle=1;html=1;whiteSpace=wrap;startSize=30;rounded=1;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="260" height="293" as="geometry"/></mxCell><mxCell id="erd-4" value="&lt;b&gt;🔑 Primary Key Code[10]&lt;/b&gt;&lt;br&gt;Margin Threshold %&lt;br&gt;Warning Band %&lt;br&gt;Strategic Allowance %&lt;br&gt;Block on Release&lt;br&gt;Include Variance Trend&lt;br&gt;Variance Trend Days&lt;br&gt;Allow Pending Lots&lt;br&gt;Inspection Nos.&lt;br&gt;Rebate Accrual Nos.&lt;br&gt;Rebate Receivable Acc.&lt;br&gt;Rebate Income Acc.&lt;br&gt;Rebate Source Code&lt;br&gt;Loyalty Period (DateFormula)&lt;br&gt;Enable Telemetry" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="erd-3"><mxGeometry y="30" width="260" height="263" as="geometry"/></mxCell><mxCell id="erd-5" value="TE50105 User Setup (ext)" style="swimlane;fontStyle=1;html=1;whiteSpace=wrap;startSize=30;rounded=1;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="260" height="72" as="geometry"/></mxCell><mxCell id="erd-6" value="MG Can Override Margin&lt;br&gt;MG Min. Override Margin %" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="erd-5"><mxGeometry y="30" width="260" height="42" as="geometry"/></mxCell><mxCell id="erd-7" value="No. Series" style="swimlane;fontStyle=1;html=1;whiteSpace=wrap;startSize=30;rounded=1;arcSize=4;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=#ffffff;align=center;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="260" height="55" as="geometry"/></mxCell><mxCell id="erd-8" value="&lt;b&gt;🔑 Code&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="erd-7"><mxGeometry y="30" width="260" height="25" as="geometry"/></mxCell><mxCell id="erd-9" value="G/L Account" style="swimlane;fontStyle=1;html=1;whiteSpace=wrap;startSize=30;rounded=1;arcSize=4;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=#ffffff;align=center;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="260" height="55" as="geometry"/></mxCell><mxCell id="erd-10" value="&lt;b&gt;🔑 No.&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="erd-9"><mxGeometry y="30" width="260" height="25" as="geometry"/></mxCell><mxCell id="erd-11" value="Source Code" style="swimlane;fontStyle=1;html=1;whiteSpace=wrap;startSize=30;rounded=1;arcSize=4;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=#ffffff;align=center;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="260" height="55" as="geometry"/></mxCell><mxCell id="erd-12" value="&lt;b&gt;🔑 Code&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="erd-11"><mxGeometry y="30" width="260" height="25" as="geometry"/></mxCell><mxCell id="erd-13" value="Inspection / Rebate Nos." style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=0;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="erd-3" target="erd-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="erd-14" value="Receivable / Income" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=0;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="erd-3" target="erd-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="erd-15" value="Rebate Source Code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=0;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="erd-3" target="erd-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="erd-16" value="TE50102 Vendor (ext)" style="swimlane;fontStyle=1;html=1;whiteSpace=wrap;startSize=30;rounded=1;arcSize=4;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="90" width="260" height="55" as="geometry"/></mxCell><mxCell id="erd-17" value="MG Landed Cost Profile" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="erd-16"><mxGeometry y="30" width="260" height="25" as="geometry"/></mxCell><mxCell id="erd-18" value="T50101 MG Landed Cost Profile" style="swimlane;fontStyle=1;html=1;whiteSpace=wrap;startSize=30;rounded=1;arcSize=4;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;align=center;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="190" width="260" height="140" as="geometry"/></mxCell><mxCell id="erd-19" value="&lt;b&gt;🔑 Code, Line No.&lt;/b&gt;&lt;br&gt;Description&lt;br&gt;Cost Type (enum 50100)&lt;br&gt;Calculation (Percent / Fixed)&lt;br&gt;Value&lt;br&gt;Allocation Method (enum 50101)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;strokeColor=none;fillColor=none;" vertex="1" parent="erd-18"><mxGeometry y="30" width="260" height="110" as="geometry"/></mxCell><mxCell id="erd-20" value="TE50101 Item (e